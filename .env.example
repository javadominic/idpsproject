# IDPS Environment Configuration
# Copy to .env and customize for your deployment

# ─── Application ────────────────────────────────────────
IDPS_ENV=development
IDPS_LOG_LEVEL=INFO
IDPS_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64
IDPS_TENANT_ID=default

# ─── Kafka Message Bus ──────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=idps-cluster
KAFKA_AUTO_OFFSET_RESET=latest

# ─── PostgreSQL (Relational Store) ──────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=idps
POSTGRES_USER=idps
POSTGRES_PASSWORD=change-me-in-production

# ─── ClickHouse (Analytics Store) ───────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=idps_analytics
CLICKHOUSE_USER=idps
CLICKHOUSE_PASSWORD=change-me-in-production

# ─── Redis (Cache & Hot Data) ───────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ─── API Gateway ────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
API_RATE_LIMIT=100/minute
API_CORS_ORIGINS=http://localhost:3000

# ─── Observability ──────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=idps
PROMETHEUS_PORT=9090

# ─── TLS Inspection ────────────────────────────────────
TLS_INSPECTION_MODE=metadata  # metadata | intercept | hybrid
TLS_CA_CERT_PATH=/etc/idps/certs/ca.pem
TLS_CA_KEY_PATH=/etc/idps/certs/ca-key.pem

# ─── Enforcement ────────────────────────────────────────
ENFORCEMENT_MODE=shadow  # shadow | staged | enforce
ENFORCEMENT_FAIL_MODE=fail-open  # fail-open | fail-closed
ENFORCEMENT_DRY_RUN=true

# ─── Deception ──────────────────────────────────────────
DECEPTION_ENABLED=true
HONEYPOT_BIND_ADDRESS=0.0.0.0
HONEYPOT_PORTS=22,23,80,443,445,3389,8080

# ─── Sandbox / Dynamic Analysis ────────────────────────
SANDBOX_ENABLED=true
SANDBOX_BACKEND=local  # local | cuckoo | cape | hybrid-analysis
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MAX_CONCURRENT=5

# ─── Compliance ─────────────────────────────────────────
COMPLIANCE_FRAMEWORKS=pci-dss,soc2  # pci-dss, hipaa, soc2, gdpr
COMPLIANCE_REPORT_SCHEDULE=0 0 * * 0  # Weekly on Sunday midnight
COMPLIANCE_RETENTION_DAYS=365

# ─── Multi-Tenancy ──────────────────────────────────────
MULTI_TENANT_ENABLED=false
TENANT_ISOLATION_MODE=logical  # logical | physical
